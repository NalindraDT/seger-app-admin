# Port untuk dev server (Vite) dan runtime Docker (serve)
PORT=3000

# Build-time (Vite) - dipakai jika runtime config belum tersedia
VITE_API_BASE_URL=http://localhost:3001/api/v1

# Runtime Docker (prioritas utama, override tanpa rebuild)
# Catatan: URL ini diakses dari browser Anda, bukan dari dalam container.
# Backend lokal via PLTU-APP-BACKEND/docker-compose.yml → port 3001
API_BASE_URL=http://localhost:3001/api/v1
